# ─────────────────────────────────────────────────────────────────────────────
# GoaRAG — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# ── LLM generation ───────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Defaults to GroqCloud — get a key at
# https://console.groq.com. Required.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Sends `reasoning_budget`, a non-standard field only some gateways accept —
# Groq returns HTTP 400 for it. Leave OFF unless GROQ_BASE_URL points at a
# gateway that supports it. Even there it adds 30-120s of latency for a small
# quality difference on grounded RAG.
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_MAX_TOKENS=2048
LLM_REASONING_BUDGET=4096
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2

# ── ElevenLabs (speech-to-text) ──────────────────────────────────────────────
# Get a key at https://elevenlabs.io — the key only needs the `speech_to_text` scope.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# ── Sarvam AI (text-to-speech, preferred for Indic languages) ────────────────
# Get a key at https://dashboard.sarvam.ai. TTS tries Sarvam first and falls
# back to ElevenLabs, which needs a paid plan (free keys return HTTP 402).
SARVAM_API_KEY=
# v2 is the default for latency: ~1s regardless of input length, against ~3.7s
# for a sentence and ~10.6s at the 500-char cap on v3. v3 is the better voice —
# switch if quality matters more than responsiveness.
SARVAM_TTS_MODEL=bulbul:v2
# Speakers are model-specific — a bulbul:v2 name on bulbul:v3 is rejected. A
# name from the other generation is translated to its counterpart automatically.
# bulbul:v2 female: anushka, manisha, vidya, arya
# bulbul:v2 male:   abhilash, karun, hitesh
# bulbul:v3 female: priya, ritu, neha, pooja, simran, kavya, ishita, shreya,
#                   roopa, tanya, shruti, suhani, kavitha, rupali, niharika
# bulbul:v3 male:   aditya, ashutosh, rahul, rohan, amit, dev, ratan, varun,
#                   manan, sumit, kabir, aayan, shubh, advait, anand, tarun,
#                   sunny, mani, gokul, vijay, mohit, rehan, soham
SARVAM_TTS_SPEAKER=anushka
# Does not change synthesis time, only payload size. 8000 is about a third the
# bytes of 22050, at telephone quality.
SARVAM_TTS_SAMPLE_RATE=22050
# Used when a request does not specify a language. One of: as-IN, bn-IN, brx-IN,
# doi-IN, en-IN, gu-IN, hi-IN, kn-IN, kok-IN, ks-IN, mai-IN, ml-IN, mni-IN,
# mr-IN, ne-IN, od-IN, pa-IN, sa-IN, sat-IN, sd-IN, ta-IN, te-IN, ur-IN.
SARVAM_TTS_LANGUAGE=en-IN

STT_TIMEOUT_MS=120000
# Max accepted upload size for audio, in megabytes.
MAX_AUDIO_UPLOAD_MB=25

# ── Embeddings ───────────────────────────────────────────────────────────────
# BAAI/bge-m3 via ONNX Runtime, running in-process — no embedding API, no key,
# no per-query cost. The first run downloads ~550MB of weights into ./models.
#
# Changing the model or its dimensions invalidates the existing index: query
# vectors must come from the same model that built it. Re-run `npm run index`
# after any change here.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS=512
# int8 (542MB, fastest) | q4f16 (668MB) | fp32 (2.2GB, most accurate)
EMBEDDING_QUANTIZATION=int8

# ── Reranker ─────────────────────────────────────────────────────────────────
# `local`     → BAAI bge-reranker-base cross-encoder via ONNX (~266MB download).
# `heuristic` → zero-dependency lexical+score fusion reranker (no download).
#
# This is the single biggest latency lever in the pipeline. Measured over 30
# queries (see docs/benchmarks), with models warmed:
#
#   local      total p50 2.06s · p70 2.13s · p100 2.37s · recall@5 44.2% · MRR 53.6%
#   heuristic  total p50  593ms · p70  669ms · p100  781ms · recall@5 37.5% · MRR 42.0%
#
# The cross-encoder costs ~1.55s at p50 because it runs 10 forward passes on
# CPU. `heuristic` is the default so the pipeline stays inside a latency budget;
# switch to `local` when retrieval quality matters more than responsiveness.
RERANKER_PROVIDER=heuristic
RERANKER_MODEL=Xenova/bge-reranker-base
RERANKER_QUANTIZATION=int8
RERANK_BATCH_SIZE=4

# ── Vector store ─────────────────────────────────────────────────────────────
# `qdrant`   → Qdrant server (production). Uses native dense + sparse vectors.
# `embedded` → disk-persisted in-process store (dev fallback, no Docker needed).
# `auto`     → try Qdrant, transparently fall back to embedded if unreachable.
VECTOR_STORE=auto
QDRANT_URL=http://localhost:6333
# Required for Qdrant Cloud; leave blank for local Docker.
QDRANT_API_KEY=
QDRANT_COLLECTION=goarag_msmarco_xi
EMBEDDED_STORE_PATH=./storage/vectors

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
# Reciprocal Rank Fusion constant for dense+sparse merging.
RRF_K=60
# Maximal Marginal Relevance: 1.0 = pure relevance, 0.0 = pure diversity.
MMR_LAMBDA=0.7
ENABLE_MMR=true
ENABLE_PARENT_EXPANSION=true

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=220
CHUNK_MIN_TOKENS=48
CHUNK_OVERLAP_TOKENS=48
PARENT_CHUNK_TOKENS=700
SEMANTIC_BREAKPOINT_PERCENTILE=88
SLIDING_WINDOW_TOKENS=160
SLIDING_WINDOW_STRIDE=80

# ── Guardrails ───────────────────────────────────────────────────────────────
# Minimum top reranked score for context to count as relevant (0-1).
SIMILARITY_THRESHOLD=0.28
# Below this overall confidence the API returns the "not enough information" refusal.
CONFIDENCE_THRESHOLD=0.42
# Minimum fraction of answer sentences that must be grounded in retrieved context.
GROUNDEDNESS_THRESHOLD=0.55
ENABLE_GUARDRAILS=true
ENABLE_HALLUCINATION_CHECK=true

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_QUERY_MAX=20
RATE_LIMIT_TRANSCRIBE_MAX=12

# ── Dataset / indexing ───────────────────────────────────────────────────────
DATASET_REPO=ai4bharat/MSMARCO-XI
DATASET_SPLIT=validation
# Where rows come from:
#   parquet → download the per-language Parquet file from the HF repo and decode
#             locally. ~440MB per language, cached in dataset/raw/, paid once.
#   api     → HuggingFace datasets-server. NOTE: this dataset's `/rows` endpoint
#             is broken upstream (ArrowNotImplementedError on the nested
#             `passages` struct), so only `/first-rows` works and it returns
#             ~18 rows. Fine for a smoke test, too small to benchmark.
#   auto    → try parquet, fall back to api.
DATASET_SOURCE=auto
# How many source rows (query + its passages) to pull. Each row carries ~10
# passages, and each passage is indexed in its own language plus English.
DATASET_MAX_ROWS=300
# Target languages to index, split evenly across DATASET_MAX_ROWS.
# One Parquet file is downloaded per language. Blank = hin_Deva.
# Available: asm_Beng ben_Beng guj_Gujr hin_Deva kan_Knda mal_Mlym mar_Deva
#            npi_Deva ory_Orya pan_Guru san_Deva tam_Taml tel_Telu urd_Arab
DATASET_LANGUAGES=hin_Deva
# Index the original English passages alongside translated ones.
DATASET_INCLUDE_ENGLISH=true
DATASET_DIR=./dataset
INDEX_BATCH_SIZE=64
INDEX_CONCURRENCY=3

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Only VITE_-prefixed vars reach the browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8787
